# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略,切勿提交到版本库。
# 配置文件 config/config.toml 中的 *_ref 字段即指向这里的变量名。

# ── LLM(OpenAI 兼容端点)──
# config/config.toml 默认端点为 OpenAI 官方 API;第三方兼容端点建议在 UI 中新增。
OPENAI_API_KEY=

# ── 资讯情报源(均为免费注册;缺失则该源自动禁用并告警)──
CRYPTOPANIC_TOKEN=
FINNHUB_KEY=
FRED_KEY=

# ── 本地运行控制(可选)──
# BINANCE_AGENT_HEADLESS=1
# BINANCE_AGENT_PROFILE=default  # default / demo / demo-live
# BINANCE_AGENT_CONFIG=config/config.toml
# BINANCE_AGENT_RUNTIME_CONFIG=
# BINANCE_AGENT_DATA_DIR=  # 可选:将 runs/checkpoints/demo 数据重定向到指定目录
# HTTPS_PROXY=
